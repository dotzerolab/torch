# Copy to .env (git-ignored) and adjust. Docker Compose reads the same file for the dev services.

# Port the Node server listens on.
PORT=3000
# Dev only: where the web dev server proxies /api. Empty means http://localhost:PORT.
API_TARGET=
# Public URL of the web app, used in links the server builds (emails, sign-in callbacks).
APP_URL=http://localhost:5173
# Postgres connection string; the dev compose creates user, password and database "torch" on POSTGRES_PORT.
DATABASE_URL=postgres://torch:torch@localhost:5432/torch
# SMTP server that sends the sign-in emails; the dev compose starts Mailpit on MAILPIT_SMTP_PORT.
SMTP_URL=smtp://localhost:1025
# Set to true only behind a trusted reverse proxy: the client IP is then read from x-forwarded-for for rate limits.
TRUST_PROXY=false
# Path to a brand JSON file (white label); empty uses the built-in default brand. A bad file stops startup.
BRAND_CONFIG_PATH=

# ElectricSQL sync service (the dev compose starts one on ELECTRIC_PORT). The server proxies shape requests to it;
# the browser never talks to it. Empty ELECTRIC_URL turns the sync routes off. A set URL needs the secret.
ELECTRIC_URL=http://localhost:3010
# Shared secret between the server and Electric. Never sent to the browser or logged. Production: set a long random one.
ELECTRIC_SECRET=dev-electric-secret

# S3-compatible storage for attachments (the dev compose starts one on S3_PORT).
S3_ENDPOINT=http://localhost:9000
# Bucket that holds attachments.
S3_BUCKET=attachments-dev
# Access key of the storage; the dev compose uses it as the root key. Production: set a real one.
S3_ACCESS_KEY_ID=dev-access-key
# Secret of the storage; the dev compose uses it as the root secret. Production: set a real one.
S3_SECRET_ACCESS_KEY=dev-secret-key
# Region name of the bucket; any value works for a self-hosted storage service.
S3_REGION=us-east-1
# Path-style addressing (host/bucket/key), which most self-hosted S3 services need; "false" for virtual-hosted style.
S3_FORCE_PATH_STYLE=true
# Address the browser uses to reach the storage when it differs from S3_ENDPOINT (uploads and downloads go there); empty means the same.
S3_PUBLIC_ENDPOINT=
# Largest attachment in bytes, 1 to 26214400 (25 MiB, the default).
ATTACHMENT_MAX_BYTES=26214400
# Bucket the end-to-end stacks use for attachments (their own, so the browser rules for the e2e origins never replace
# the ones of the bucket above); created on the first e2e run. Empty means e2e-attachments.
E2E_S3_BUCKET=

# Dev compose only: host ports on localhost (change them when 5432, 3010, 9000, 9001, 1025 or 8025 are taken).
POSTGRES_PORT=5432
ELECTRIC_PORT=3010
S3_PORT=9000
S3_CONSOLE_PORT=9001
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
# Mailpit HTTP API, used by integration and e2e tests to read the sign-in emails (set it to run them).
MAILPIT_API_URL=http://localhost:8025
