{
  "name": "torch",
  "private": true,
  "version": "0.0.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dotzerolab/torch.git"
  },
  "homepage": "https://github.com/dotzerolab/torch#readme",
  "bugs": {
    "url": "https://github.com/dotzerolab/torch/issues"
  },
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm -r typecheck && tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build": "pnpm -r build",
    "e2e": "pnpm --filter @torch/web e2e",
    "i18n:check": "node scripts/check-i18n.ts",
    "brand:check": "node scripts/check-brand-strings.ts",
    "licenses:check": "node scripts/check-licenses.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@types/node": "^26.6.6",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0",
    "yaml": "^2.8.0"
  }
}
