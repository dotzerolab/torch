{
  "name": "@torch/server",
  "private": true,
  "version": "0.0.0",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../../.env src/main.ts",
    "start": "node dist/main.js",
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --target=node26 --outfile=dist/main.js --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\" --external:pg-native",
    "typecheck": "tsc --noEmit -p .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=../../.env src/db/migrate.ts",
    "db:seed": "node --env-file-if-exists=../../.env src/db/seed.ts",
    "db:seed-perf": "node --env-file-if-exists=../../.env src/cli/seed-perf.ts",
    "bootstrap": "node --env-file-if-exists=../../.env src/cli/bootstrap.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.8",
    "@torch/shared": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.18",
    "nodemailer": "^10.5.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@electric-sql/client": "1.5.28",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2"
  }
}
